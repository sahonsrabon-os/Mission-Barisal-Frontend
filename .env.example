# Code with AI — environment configuration template.
# Copy to .env and edit:   cp .env.example .env
# Loaded automatically by server/lib/env.js when the server starts.
# PRECEDENCE: real environment variables  >  .env file  >  built-in defaults.

# --- HTTP ---
PORT=8787
HOST=127.0.0.1            # set 0.0.0.0 to allow LAN / tunnel access

# --- Security (optional) ---
# OC_ACCESS_TOKEN=change-me
# OC_ROOTS=/path/to/workspace

# --- Logging / behaviour ---
# OC_LOG_FILE=logs/server.log
# OC_PROVIDERS_FORCE=1
# OC_ENV_FILE=

# --- Admin-managed LLM providers (seeded into Settings at boot) ---
# OC_PROVIDER_<n>_{NAME,BASE_URL,API_KEY,MODELS,MODEL}
# MODELS: id=Name, id2=Name2  (or JSON object)
# MODEL : default model id — the UI auto-selects it on load
# API_KEY may be empty if the endpoint does not require one.

# OC_PROVIDER_1_NAME=My OpenAI-Compatible Provider
# OC_PROVIDER_1_BASE_URL=https://api.example.com/v1
# OC_PROVIDER_1_API_KEY=sk-...
# OC_PROVIDER_1_MODELS=gpt-4o=GPT-4o,gpt-4o-mini=GPT-4o mini
# OC_PROVIDER_1_MODEL=gpt-4o

# OC_PROVIDER_2_NAME=Local Ollama
# OC_PROVIDER_2_BASE_URL=http://127.0.0.1:11434/v1
# OC_PROVIDER_2_API_KEY=
# OC_PROVIDER_2_MODELS=qwen2.5-coder=Qwen 2.5 Coder
# OC_PROVIDER_2_MODEL=qwen2.5-coder
